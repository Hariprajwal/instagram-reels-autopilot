# LLM Engine Configuration
# Primary: Groq API (Ultra-fast Llama-3.3-70B / Llama-3.1-8B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: OpenRouter API (Access to Claude, GPT-4o, Llama-3.3, Gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback 1: Local Ollama
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Fallback 2: Deterministic Rule Engine is always active if LLMs are unavailable

# Chrome CDP Settings
CHROME_CDP_URL=http://127.0.0.1:9222
REEL_COOLDOWN_SECONDS=3.5
ELIGIBILITY_MODE=engaged  # Options: engaged (all engaged commenters with msg button) or strict (only 'DM me')
NAVIGATION_MODE=in_tab  # Options: in_tab, new_tab
AUTO_NEXT_REEL=true     # Automatically click Down Arrow to next reel when all comments finish
CLEANUP_SCREENSHOTS_ON_EXIT=true  # Auto-delete temp screenshots on session exit

# Safety Controls
HUMAN_IN_THE_LOOP=true
AUTO_SEND_DM=true
MAX_COMMENTS_PER_REEL=25
MAX_PROFILES_PER_SESSION=100
